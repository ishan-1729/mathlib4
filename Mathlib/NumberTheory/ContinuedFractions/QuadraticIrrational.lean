/-!
# Periodic continued fractions and quadratic irrationals

Let `v` be an element of a linear ordered field `K` with a floor function, for example a real
number. We prove **Euler's theorem**: if the continued fraction of `v` is eventually periodic, then
`v` is a quadratic irrational, that is, the minimal polynomial of `v` over `ℚ` has degree `2`.

The converse is Lagrange's theorem.

## Main results

- `GenContFract.adjoin_completeQuotient`: the complete quotients of `v` generate the same field
  as `v`.
- `GenContFract.natDegree_minpoly_completeQuotient`: the complete quotients of `v` have the same
  degree as `v`.
- `GenContFract.IsEventuallyPeriodic.natDegree_minpoly_eq_two`: if the continued fraction of `v`
  is eventually periodic, then the minimal polynomial of `v` over `ℚ` has degree `2`.

## Implementation notes

That `v` is a quadratic irrational is expressed as `(minpoly ℚ v).natDegree = 2`. This says that
`v` is algebraic over `ℚ` (otherwise `minpoly ℚ v = 0`), that `v` is a root of a polynomial of
degree `2` with rational coefficients and that `v` is not rational (otherwise `minpoly ℚ v` has
degree `1`).

## References

- [G. H. Hardy and E. M. Wright, *An Introduction to the Theory of Numbers*, Theorem 176]
  [hardy2008introduction]

## Tags

continued fraction, periodic, quadratic irrational
-/

public section

open Polynomial IntermediateField

namespace GenContFract

open GenContFract (of)

/-- If `x` and `y` generate the same extension of `F` and `x` is integral over `F`, then so is
`y`. -/
private theorem isIntegral_of_adjoin_simple_eq {F L : Type*} [Field F] [Field L] [Algebra F L]
    {x y : L} (h : F⟮x⟯ = F⟮y⟯) (hx : IsIntegral F x) : IsIntegral F y :=
  have := isAlgebraic_adjoin_simple hx
  isIntegral_iff.mp (Algebra.IsIntegral.isIntegral (⟨y, h ▸ mem_adjoin_simple_self F y⟩ : F⟮x⟯))

variable {K : Type*} [Field K] [LinearOrder K] [FloorRing K]

section Adjoin

variable (F : Type*) [Field F] [Algebra F K] (v : K) (n : ℕ)

/-- The complete quotients of `v` generate the same field as `v`. -/
theorem adjoin_completeQuotient : F⟮completeQuotient v n⟯ = F⟮v⟯ := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [← ih]
    refine le_antisymm (adjoin_simple_le_iff.mpr ?_) (adjoin_simple_le_iff.mpr ?_)
    · rw [completeQuotient_succ]
      exact inv_mem (sub_mem (mem_adjoin_simple_self F _) (intCast_mem _ _))
    · rw [← floor_add_inv_completeQuotient_succ v n]
      exact add_mem (intCast_mem _ _) (inv_mem (mem_adjoin_simple_self F _))

/-- The complete quotients of `v` lie in the field generated by `v`. -/
theorem completeQuotient_mem_adjoin : completeQuotient v n ∈ F⟮v⟯ :=
  adjoin_completeQuotient F v n ▸ mem_adjoin_simple_self F _

/-- The complete quotients of `v` have the same degree over `F` as `v`. -/
theorem natDegree_minpoly_completeQuotient :
    (minpoly F (completeQuotient v n)).natDegree = (minpoly F v).natDegree := by
  have h := adjoin_completeQuotient F v n
  by_cases hv : IsIntegral F v
  · rw [← adjoin.finrank hv, ← adjoin.finrank (isIntegral_of_adjoin_simple_eq h.symm hv), h]
  · rw [minpoly.eq_zero hv, minpoly.eq_zero (mt (isIntegral_of_adjoin_simple_eq h) hv)]

end Adjoin

variable [IsStrictOrderedRing K] {v : K}

/-- If `v` is equal to its complete quotient `vₙ₊₁`, then
`Bₙ * v ^ 2 + (Bₙ₋₁ - Aₙ) * v - Aₙ₋₁ = 0`, where `Aₙ / Bₙ` are the convergents of `v`. -/
private theorem exists_natDegree_eq_two_and_aeval_eq_zero (hv : ¬(of v).Terminates) {n : ℕ}
    (h : completeQuotient v (n + 1) = v) : ∃ q : ℚ[X], q.natDegree = 2 ∧ aeval v q = 0 := by
  have hn : ¬(of v).TerminatedAt n := not_exists.mp hv n
  have key := eq_completeQuotient_mul_contsAux_div hn
  have hpos := completeQuotient_mul_contsAux_b_add_pos hn
  have hB : 0 < ((of v).contsAux (n + 1)).b := of_den_pos
  obtain ⟨⟨a, b⟩, hab⟩ := exists_gcf_pair_rat_eq_of_nth_contsAux v (n + 1)
  obtain ⟨⟨a', b'⟩, hab'⟩ := exists_gcf_pair_rat_eq_of_nth_contsAux v n
  rw [h, hab, hab'] at key hpos
  rw [hab] at hB
  rw [eq_div_iff hpos.ne'] at key
  dsimp only [Pair.map] at key hB
  have hb : b ≠ 0 := by
    rintro rfl
    simp at hB
  have hq : (b : K) * v ^ 2 + (b' - a) * v + -a' = 0 := by linear_combination key
  exact ⟨C b * X ^ 2 + C (b' - a) * X + C (-a'), natDegree_quadratic hb, by simpa using hq⟩

private theorem natDegree_minpoly_eq_two_of_completeQuotient_eq (hv : ¬(of v).Terminates) {p : ℕ}
    (hp : 0 < p) (h : completeQuotient v p = v) : (minpoly ℚ v).natDegree = 2 := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hp.ne'
  obtain ⟨q, hq, hqv⟩ := exists_natDegree_eq_two_and_aeval_eq_zero hv h
  have hq0 : q ≠ 0 := ne_zero_of_natDegree_gt (n := 1) (by lia)
  refine le_antisymm (hq ▸ natDegree_le_of_dvd (minpoly.dvd ℚ v hqv) hq0)
    ((minpoly.two_le_natDegree_iff (isAlgebraic_iff_isIntegral.mp ⟨q, hq0, hqv⟩)).mpr ?_)
  rintro ⟨r, rfl⟩
  exact hv ((terminates_iff_rat _).mpr ⟨r, by simp⟩)

/-- **Euler's theorem**: if the continued fraction of `v` is eventually periodic, then `v` is a
quadratic irrational, that is, the minimal polynomial of `v` over `ℚ` has degree `2`. -/
theorem IsEventuallyPeriodic.natDegree_minpoly_eq_two (h : (of v).IsEventuallyPeriodic) :
    (minpoly ℚ v).natDegree = 2 := by
  obtain ⟨hv, N, p, hp, h⟩ := of_isEventuallyPeriodic_iff.mp h
  rw [← natDegree_minpoly_completeQuotient ℚ v N]
  exact natDegree_minpoly_eq_two_of_completeQuotient_eq
    (of_completeQuotient_terminates_iff.not.mpr hv) hp (by rw [← completeQuotient_add, add_comm, h])

end GenContFract
